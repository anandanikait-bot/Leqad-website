{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.ts && node scripts/clean-production.mjs",
    "preview": "node server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "start": "node server.mjs",
    "test:browser": "playwright test",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "screenshots:demo": "tsx scripts/capture-demo-states.ts",
    "typecheck": "tsc --noEmit",
    "audit:quality": "node scripts/audit-quality-pass.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
